# Copy to .env for local work. Never commit .env — the repo's .gitignore excludes
# .env and .env.* for exactly this reason, and a key that reaches git history
# cannot be deleted from it.

NODE_ENV=development
PORT=3000

# The local compose stack (`infra/floci/docker-compose.yml`, service `postgres`).
# In deployment this is the Neon pooled connection string, which carries TLS
# (`?sslmode=require`) and a -pooler host; the code needs no change beyond the
# value, because TLS is driven by the URL rather than by the hostname.
DATABASE_URL=postgres://class_tt:local_dev_only@localhost:5433/catalogue

# Pool sizing. tasks × DB_POOL_MAX must stay under the endpoint's connection
# limit: Neon's free tier is tight enough that four tasks of 10 would exhaust it.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=2000
READY_TIMEOUT_MS=1000

# Inside a transaction: how long to wait for a lock (a room another request is
# editing) and how long any single statement may run. Both fail loudly instead of
# hanging until the load balancer gives up.
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000

LOG_LEVEL=info
SERVICE_NAME=class-tt-catalogue

# --- Signing key custody -------------------------------------------------------
# The key that signs access tokens is stored only as ciphertext: Secrets Manager
# holds it sealed, KMS holds the key that unseals it. Set KMS_KEY_ALIAS to take
# that path. Leave it empty to read a PEM file instead — allowed only when
# NODE_ENV is not production, and logged as `keystore.unsealed_from_file`.
KMS_KEY_ALIAS=alias/class-tt-keystore
JWT_SECRET_ID=class-tt/jwt-signing-key

# Development only: `node scripts/seal-key.mjs --dev` writes this file (0600).
JWT_KEY_FILE=keys/dev.pem

# Where the SDK should look. Against floci these point at the local emulator; in
# deployment both are removed and the ECS task role supplies credentials.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566

# --- Turnstile -----------------------------------------------------------------
# Cloudflare's public test secret: the challenge always passes, so local login
# works without an account. In deployment this is the real secret from the
# dashboard, and a wrong value fails closed (403 TURNSTILE_FAILED) rather than open.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- Token lifetimes -----------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=7200
REFRESH_TTL_DAYS=7
SESSION_ABSOLUTE_DAYS=30
REFRESH_GRACE_SECONDS=30
MAX_SESSIONS_PER_USER=10

